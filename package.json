{
    "name": "@onetype/stack-api-kit",
    "version": "8.2.0-rc.1",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "import": "./dist/testing.js"
        }
    },
    "scripts": {
        "check": "tools/check.sh",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "boundaries": "node tools/boundaries.mjs",
        "docs": "node tools/docs.mjs",
        "build": "tsup && node tools/name-types.mjs && node tools/schema.mjs",
        "prepublishOnly": "tools/check.sh && tsup && node tools/name-types.mjs",
        "prepack": "tsup && node tools/name-types.mjs",
        "schema": "node tools/schema.mjs",
        "declared": "node tools/declared.mjs"
    },
    "dependencies": {
        "zod": "^4.5.4"
    },
    "peerDependencies": {
        "better-sqlite3": ">=13",
        "drizzle-orm": ">=0.45",
        "hono": ">=4",
        "@hono/node-server": ">=2",
        "ws": ">=8"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.4.0",
        "better-sqlite3": "^13.0.3",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.5",
        "tsup": "^8.5.1",
        "typescript": "^5.7.0",
        "vitest": "^4.1.11",
        "@hono/node-server": "^2.1.1",
        "ws": "^8.21.3",
        "@types/ws": "^8.18.1"
    },
    "description": "A kernel that holds plugins apart: contracts, routes, events, hooks, permissions and scope, refused at startup rather than in review.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onetype-ai/stack-api-kit.git"
    },
    "homepage": "https://github.com/onetype-ai/stack-api-kit#readme",
    "bugs": {
        "url": "https://github.com/onetype-ai/stack-api-kit/issues"
    },
    "keywords": [
        "plugins",
        "kernel",
        "api",
        "hono",
        "drizzle",
        "sqlite",
        "typescript",
        "multi-tenant"
    ],
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist",
        "schema.md",
        "README.md",
        "CHANGELOG.md",
        "#docs",
        "!#docs/progress"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "peerDependenciesMeta": {
        "@hono/node-server": {
            "optional": true
        },
        "ws": {
            "optional": true
        }
    }
}
